      "notes": "External edge ingress infrastructure managed by cloud provider."
    },
    {
      "name": "Production DNS Nameserver (Route53 / Cloudflare)",
      "type": "dns",
      "status": "REQUIRES DNS",
      "notes": "Production domain A/AAAA/CNAME records mapping to edge IP."
    },
    {
