# ==============================================================================
# AegisAI Enterprise — Backend Environment Variable Template (.env.example)
# ==============================================================================

ENVIRONMENT=dev
PROJECT_NAME="AegisAI Enterprise Backend"

SECRET_KEY=replace-with-secure-32-char-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegisai

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
RATE_LIMIT_RPM=60

TAVILY_API_KEY=
MEMORY_PROVIDER=mock
RESEARCH_PROVIDER=mock
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

DOCUMENT_STORAGE_PATH=storage
MAX_DOCUMENT_SIZE_MB=50

CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "testserver"]
ENABLE_HSTS=false
