# ==============================================================================
# AegisAI Enterprise — Free Public Demo Deployment Template (.env.demo.example)
#
# Target Architecture:
# - Frontend: Vercel (React 19 SPA)
# - Backend: Render (FastAPI Web Service)
# - Database: Supabase PostgreSQL (Session Pooler / Port 5432)
# - Redis: Upstash Redis (Serverless TLS / rediss://)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER WEB SERVICE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------

# Application Settings
ENVIRONMENT=prod
APP_VERSION=1.0.0-rc.1
PROJECT_NAME="AegisAI Enterprise Backend"

# Security: Generate a 32+ character random secret (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-secure-32-char-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase PostgreSQL Database (Session Pooler / Port 5432)
# Example: postgresql://postgres.rqyoqchhfgtcxxhxpfak:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.rqyoqchhfgtcxxhxpfak:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Upstash Serverless Redis (TLS connection string starting with rediss://)
# Example: rediss://default:YOUR_UPSTASH_PASSWORD@ap-south-1-aegis.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@your-endpoint.upstash.io:6379

# Web Security & CORS (Allow your Vercel deployment and local preview)
# Comma-separated or JSON array format supported
CORS_ORIGINS=https://your-aegisai-frontend.vercel.app,http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com,*.vercel.app
ENABLE_HSTS=false

# Provider Configurations for Free Demo
MEMORY_PROVIDER=mock
RESEARCH_PROVIDER=mock
DOCUMENT_STORAGE_PATH=storage
MAX_DOCUMENT_SIZE_MB=50

# Optional: Real LLM API Keys (if running live model inference instead of mock showcase)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
# DEFAULT_AI_PROVIDER=openai
# DEFAULT_AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. VERCEL FRONTEND ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://your-backend.onrender.com
