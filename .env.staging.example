# ==============================================================================
# AegisAI Enterprise — Staging Environment Configuration Template
# ==============================================================================

# Core System
ENVIRONMENT=staging
PROJECT_NAME="AegisAI Enterprise Staging"
API_V1_STR=/api/v1
APP_VERSION=1.0.0-staging
GIT_COMMIT_SHA=staging-commit-sha

# Security Keys (Staging-specific, minimum 32 chars, never shared with production)
SECRET_KEY=SECURE_STAGING_KEY_AEGIS_ENTERPRISE_2026_STAGE_ISOLATION
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (Dedicated Staging PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=aegisai_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=staging_secure_password_2026
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis Cache & Message Bus (Dedicated Staging Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Document Storage (Isolated Staging Directory)
DOCUMENT_STORAGE_PATH=storage/staging
MAX_DOCUMENT_SIZE_MB=50

# Worker & Scheduler Configuration
WORKER_CONCURRENCY=5
MAX_TENANT_CONCURRENCY=3
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_TIMEOUT_SECONDS=60
SCHEDULER_POLL_INTERVAL_SECONDS=5
SCHEDULER_LEADER_TTL_SECONDS=15
JOB_MAX_RETRIES=3

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/staging-aegis.log
LOG_ROTATION=50 MB
LOG_RETENTION=7 days
METRICS_ENABLED=true

# Network & Web Security
CORS_ORIGINS=["https://staging.aegisai.enterprise","http://localhost:8080","http://127.0.0.1:8080"]
ALLOWED_HOSTS=["staging.aegisai.enterprise","backend","localhost","127.0.0.1","testserver"]
TRUSTED_PROXIES=["127.0.0.1","::1","172.16.0.0/12","10.0.0.0/8","192.168.0.0/16"]
ENABLE_HSTS=true

# AI & MCP Provider Staging Isolation (Deterministic / Mock mode for safe smoke testing)
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
MEMORY_PROVIDER=mock
RESEARCH_PROVIDER=mock
EMBEDDING_PROVIDER=openai
