# ==============================================================================
# AegisAI Enterprise — Production & Staging Environment Variable Template
# Copy to .env or inject via orchestrator / Secret Manager. DO NOT COMMIT REAL SECRETS.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment & Security Configuration
# ------------------------------------------------------------------------------
# Active environment profile: 'prod' | 'staging' | 'dev' | 'test'
ENVIRONMENT=prod
PROJECT_NAME="AegisAI Enterprise Backend"

# JWT Signing Secret (MUST be at least 32 cryptographically random characters in production)
# Example generation: openssl rand -hex 32
SECRET_KEY=replace-with-cryptographically-secure-random-32-char-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=aegis_db_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=aegisai_production
# Optional direct connection URI (overrides individual POSTGRES_* parameters):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------------------------
# Redis Cache & Realtime Bus Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-strong-redis-password
# REDIS_URL=redis://:password@redis:6379/0

# ------------------------------------------------------------------------------
# Vector Store Configuration (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# AI Model Provider Credentials (Injected at Runtime)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
RATE_LIMIT_RPM=60

# Search & Research Integration Settings
TAVILY_API_KEY=
MEMORY_PROVIDER=mock
RESEARCH_PROVIDER=mock
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ------------------------------------------------------------------------------
# Document Storage & Limits
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_PATH=/workspace/storage
MAX_DOCUMENT_SIZE_MB=50

# ------------------------------------------------------------------------------
# Web Security, CORS & Reverse Proxy Settings
# ------------------------------------------------------------------------------
# JSON-encoded array or comma-separated list of allowed origins
CORS_ORIGINS=["https://aegisai.yourdomain.com"]
ALLOWED_HOSTS=["aegisai.yourdomain.com", "backend", "localhost"]
MAX_REQUEST_BODY_BYTES=10485760
MAX_UPLOAD_BYTES=52428800
ENABLE_HSTS=true
